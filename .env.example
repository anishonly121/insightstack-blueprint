# Database — get a free PostgreSQL instance at https://neon.tech
# Neon gives two URLs: pooled (runtime) and direct (migrations)
DATABASE_URL="postgresql://<user>:<pass>@<host>-pooler.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<pass>@<host>.neon.tech/<db>?sslmode=require"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-32-char-minimum-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="InsightStack"
NODE_ENV="development"

# SendGrid — optional for local dev; password reset emails will silently no-op without it
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="your-verified-sender@example.com"
SENDGRID_TEMPLATE_RESET_PASSWORD="d-..."

# Finnhub — free real-time stock quotes → https://finnhub.io/register
FINNHUB_TOKEN=""

# Stripe — get keys at https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY: secret key (sk_live_... or sk_test_...)
# STRIPE_WEBHOOK_SECRET: from Stripe dashboard → Webhooks → your endpoint → Signing secret
# STRIPE_PRO_PRICE_ID: price ID of the Pro plan (price_...)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: publishable key (pk_live_... or pk_test_...)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Vercel Cron — protects the /api/cron/weekly-digest endpoint
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Add the same value in Vercel → Settings → Environment Variables
CRON_SECRET=""
